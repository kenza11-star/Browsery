# Salin file ini ke .github/workflows/release.yml (konektor yang dipakai Claude tidak diberi izin menulis folder workflows).
# Manual saja. Membutuhkan 4 GitHub Secrets (nama saja, nilainya diisi pemilik repo; tidak pernah ada di repo):
#   BROWSERY_KEYSTORE_BASE64   keystore .jks di-base64
#   BROWSERY_KEYSTORE_PASSWORD
#   BROWSERY_KEY_ALIAS
#   BROWSERY_KEY_PASSWORD
# Keystore yang SAMA harus dipakai selamanya agar pembaruan APK bisa dipasang di atas versi lama.
name: Release APK

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  release:
    runs-on: ubuntu-latest
    timeout-minutes: 45
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"

      - name: Accept Android SDK licenses
        run: |
          yes | "$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager" --licenses > /dev/null || true

      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: "9.3.1"

      - name: Check signing secrets
        env:
          KS: ${{ secrets.BROWSERY_KEYSTORE_BASE64 }}
          KSP: ${{ secrets.BROWSERY_KEYSTORE_PASSWORD }}
          KA: ${{ secrets.BROWSERY_KEY_ALIAS }}
          KP: ${{ secrets.BROWSERY_KEY_PASSWORD }}
        run: |
          for v in KS KSP KA KP; do
            if [ -z "${!v}" ]; then echo "::error::GitHub Secret untuk $v belum diisi; rilis dibatalkan."; exit 1; fi
          done

      - name: Decode keystore
        env:
          KS: ${{ secrets.BROWSERY_KEYSTORE_BASE64 }}
        run: |
          echo "$KS" | base64 -d > "$RUNNER_TEMP/release.jks"
          echo "BROWSERY_KEYSTORE_PATH=$RUNNER_TEMP/release.jks" >> "$GITHUB_ENV"

      - name: Unit test
        run: gradle :app:testDebugUnitTest --stacktrace

      - name: Assemble release APK
        env:
          BROWSERY_KEYSTORE_PASSWORD: ${{ secrets.BROWSERY_KEYSTORE_PASSWORD }}
          BROWSERY_KEY_ALIAS: ${{ secrets.BROWSERY_KEY_ALIAS }}
          BROWSERY_KEY_PASSWORD: ${{ secrets.BROWSERY_KEY_PASSWORD }}
        run: gradle :app:assembleRelease --stacktrace

      - name: Verify signature and checksum
        run: |
          APK=$(ls app/build/outputs/apk/release/*.apk | head -n1)
          "$ANDROID_HOME"/build-tools/*/apksigner verify --print-certs "$APK"
          sha256sum "$APK" | tee app/build/outputs/apk/release/SHA256SUMS.txt

      - name: Remove keystore
        if: always()
        run: rm -f "$RUNNER_TEMP/release.jks"

      - name: Upload release APK
        uses: actions/upload-artifact@v4
        with:
          name: browsery-release-apk
          path: |
            app/build/outputs/apk/release/*.apk
            app/build/outputs/apk/release/SHA256SUMS.txt
          if-no-files-found: error
